APP_PORT=18110
APP_BIND=0.0.0.0
DB_PASSWORD=replace_with_random_password
DATABASE_URL=postgresql+psycopg://ainovel:replace_with_random_password@db:5432/ainovel
REDIS_URL=redis://redis:6379/0
ADMIN_PASSWORD_HASH=generate_with_setup_script
SESSION_SECRET=replace_with_random_secret
COOKIE_SECURE=false
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=your_key_here
LLM_MODEL=your_enabled_model_or_endpoint
LLM_TRANSPORT=http
# claude_cli transport uses genuine Claude Code and Anthropic-compatible models.
# For a stable authorized outbound proxy, configure its URL here (never commit credentials).
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1,db,redis
